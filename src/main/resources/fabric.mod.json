{
  "schemaVersion": 1,
  "id": "skysettings",
  "version": "${version}",
  "name": "Sky Settings",
  "description": "Öffne mit /sky ein Menü (mit wählbarem Design) für Uhrzeit, Helligkeit, Sättigung, Himmel-, Wolken- und Nebelfarbe.",
  "authors": ["Du"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.skysettings.SkySettingsClient"]
  },
  "mixins": [
    {
      "config": "skysettings.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
